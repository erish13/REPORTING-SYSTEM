# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=reporting_system

# ── Authentication ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$...
JWT_SECRET=your_jwt_secret_at_least_32_chars

# ── Email (for forgot-password) ────────────────────────────────────────────────
# Gmail example: use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Set to true only when using port 465 (SSL); leave false for port 587 (STARTTLS)
EMAIL_SECURE=false
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password
# Optional: display name in the From field
EMAIL_FROM="Reporting System <you@gmail.com>"

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Frontend URL used in reset-password email links
APP_URL=http://localhost:5173
